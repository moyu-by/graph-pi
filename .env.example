# LLM provider configuration
LLM_PROVIDER=xiaomi
LLM_MODEL=mimo-v2.5

# Server
PORT=3001
DB_PATH=./data/graph-pi.db

# Network exposure (security-sensitive — defaults are safe, read before changing)
# Address the server binds to. Defaults to 127.0.0.1, i.e. only reachable
# from this machine. Set to 0.0.0.0 to allow other devices on your network to
# connect (e.g. to use the app from your phone while the server runs on your
# laptop). Anyone on that network can then read/write your conversations and
# spend your configured model API key's quota.
# HOST=127.0.0.1

# Comma-separated list of extra origins allowed to make cross-origin browser
# requests to the API. http://localhost:* and http://127.0.0.1:* are always
# allowed; this is only needed if you set HOST=0.0.0.0 and load the web UI
# from another device's browser, e.g. http://192.168.1.23:3000.
# ALLOWED_ORIGIN=http://192.168.1.23:3000

# Provider API keys (set the ones you need)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
