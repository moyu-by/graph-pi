{
  "name": "graph-pi",
  "version": "0.3.2",
  "description": "Graph-based conversation management for AI agents — a vibe-coding product",
  "type": "module",
  "bin": {
    "graph-pi": "./bin/graph-pi.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin",
    "packages/shared/dist",
    "packages/shared/package.json",
    "packages/server/dist",
    "packages/server/package.json",
    "packages/web/dist",
    "packages/web/package.json",
    ".env.example",
    "THIRD-PARTY-LICENSES"
  ],
  "scripts": {
    "graph-pi": "node bin/graph-pi.js",
    "build": "cd packages/shared && npx tsc && cd ../.. && cd packages/web && npx vite build && cd ../.. && cd packages/server && node build.mjs && cd ../..",
    "typecheck": "tsc -b && cd packages/server && npx tsc --noEmit && cd ../.. && cd packages/web && npx tsc --noEmit && cd ../..",
    "test": "node --test packages/shared/src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "graph",
    "conversation",
    "vibecoding",
    "chat",
    "llm"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyu-by/graph-pi.git"
  },
  "bugs": {
    "url": "https://github.com/moyu-by/graph-pi/issues"
  },
  "homepage": "https://github.com/moyu-by/graph-pi#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@xyflow/react": "^12.4.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
